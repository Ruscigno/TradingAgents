# Hermes config esqueleto — referência canônica.
# O config.yaml real (gitignored) é populado a partir do Hermes upstream
# durante o setup. Mínimo necessário aqui:

model: moonshotai/kimi-k2.6
providers:
  openrouter:
    base_url: https://openrouter.ai/api/v1
    api_key: env:OPENROUTER_API_KEY
fallback_providers:
  - openrouter

delegation:
  model: moonshotai/kimi-k2.6
  provider: openrouter
  base_url: https://openrouter.ai/api/v1
  api_key: env:OPENROUTER_API_KEY

# Sem MCP servers registrados aqui; o Hermes do TradingAgents não consome MCP
# diretamente — ele dispara `python -m cli.main recommend --full` via shell.
mcp_servers: {}
